# ROMs, saves and anything extracted from them are never committed. extract/ is anchored: a layer's extract/ holds
# recipes, which are committed
orig/
/extract/
*.nds
*.gba
*.gb
*.gbc
*.sav
*.dsv
# Emulator savestates hold the game's RAM
*.dst
*.ds[0-9]
*.mln

# Build output, patches and tool caches
build/
dist/
.cache/
*.xdelta

# Python
.venv/
__pycache__/

# Agent-local settings; shared agent config is committed
.claude/settings.local.json
.claude/worktrees/
