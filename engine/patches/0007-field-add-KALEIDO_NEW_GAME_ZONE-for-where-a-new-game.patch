From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Allen Zheng <zhenga8533@gmail.com>
Date: Wed, 4 Nov 2026 00:00:00 +0000
Subject: [PATCH] field: add KALEIDO_NEW_GAME_ZONE for where a new game starts

With KALEIDO_NEW_GAME_ZONE defined as a zone constant, a new game starts at
that zone's Fly position instead of Aspertia City's. The opening then skips
what belongs to Black 2's start: the 3D flight over Unova, and scripts 0x1d
and 0x1e of the zone it starts in, which in Aspertia City are the opening scene.
The season banner stays.
---
 src/ov035/event_mapchange.c | 8 ++++++++
 src/system/zone_spawn.c     | 7 ++++++-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/ov035/event_mapchange.c b/src/ov035/event_mapchange.c
index 94608e9e9..d9063d592 100644
--- a/src/ov035/event_mapchange.c
+++ b/src/ov035/event_mapchange.c
@@ -189,7 +189,10 @@ GameEventReturnCode EventGameOpening_Callback(GameEvent *event, u32 *state, void
         (*state)++;
         break;
     case 2:
+#ifndef KALEIDO_NEW_GAME_ZONE
+        // The flight over Unova; a game that starts elsewhere has none
         GameEvent_ChainNext(event, Event3DDemo_Create(gsys, event, 5, 0, 1));
+#endif
         (*state)++;
         break;
     case 3:
@@ -244,7 +247,10 @@ GameEventReturnCode EventFieldFirst_Callback(GameEvent *event, u32 *state, void
         break;
     case 3:
         SetActorFlag(FieldPlayer_GetActor(Field_GetPlayer(GSYS_GetField(gsys))), 4);
+#ifndef KALEIDO_NEW_GAME_ZONE
+        // Scripts 0x1d and 0x1e of the zone a new game starts in: Aspertia City's opening scene
         EventScriptCall_Start(event, 0x1d, NULL, 0, HEAPID_USER);
+#endif
         (*state)++;
         break;
     case 4:
@@ -253,7 +259,9 @@ GameEventReturnCode EventFieldFirst_Callback(GameEvent *event, u32 *state, void
         (*state)++;
         break;
     case 5:
+#ifndef KALEIDO_NEW_GAME_ZONE
         EventScriptCall_Start(event, 0x1e, NULL, 0, HEAPID_USER);
+#endif
         (*state)++;
         break;
     case 6:
diff --git a/src/system/zone_spawn.c b/src/system/zone_spawn.c
index 872314fc5..c8a02e767 100644
--- a/src/system/zone_spawn.c
+++ b/src/system/zone_spawn.c
@@ -116,9 +116,14 @@ void LoadZoneSpawnInfoCheckRail(ZoneSpawnInfo *spawn, u16 zoneId) {
     }
 }
 
-// Where a new game starts
+// Where a new game starts: the Fly position of Aspertia City, or of the zone a game names in
+// KALEIDO_NEW_GAME_ZONE
 void LoadAspertiaCitySpawnInfo(ZoneSpawnInfo *spawn) {
+#ifdef KALEIDO_NEW_GAME_ZONE
+    LoadZoneSpawnInfoCheckRail(spawn, KALEIDO_NEW_GAME_ZONE);
+#else
     LoadZoneSpawnInfoCheckRail(spawn, ZONE_ASPERTIA_CITY);
+#endif
 }
 
 static u16 ConvWarpDirToDir(s16 warpDir) {
